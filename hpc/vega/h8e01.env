# H8-E01: FASTENER guided by an LLM prior (DEC-49, DEC-50), on Vega. 14 arms
# x 16 datasets x 5 seeds, LightGBM, 1,000 fits, 6-hour cap. The priors are
# committed files; the proposer arms call OpenRouter live from the compute
# nodes (reachable, checked 2026-10-30), with the key in the clone's
# git-ignored .env. Datasets and arms slowest first.
EXPERIMENT=H8-E01
DATASETS=eodata,covertype,crop_mapping,diabetes130,higgs,har,adult,gas_drift,heloc,phishing,eye_movements,spambase,ozone_8hr,pc4,mice_protein,qsar_biodeg
METHODS=fastener:llm_opus_proposer,fastener:llm_sonnet_proposer,fastener:llm_haiku_proposer,fastener:none,fastener:seed_mrmr,fastener:llm_opus,fastener:llm_sonnet,fastener:llm_haiku,fastener:llm_opus_scrambled,fastener:llm_sonnet_scrambled,fastener:llm_haiku_scrambled,fastener:llm_opus_mating,fastener:llm_opus_mutation,fastener:llm_opus_initial
BUDGETS=experiments/h8_budgets.json
SKIP=hpc/vega/h8e01_skip.txt
TIMEOUT_HOURS=6
RUN_ARGS="--model lgbm"
# test.sbatch's step 2: a quick real job
TEST_CELL=qsar_biodeg:fastener
