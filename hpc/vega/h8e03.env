# H8-E03: H8-E01's design with nine other models (DEC-52), each with H8-E02's
# blind control. Priors are committed files; the proposer arms call OpenRouter
# from the compute nodes, each run capped at $0.015. Datasets and arms
# slowest first.
EXPERIMENT=H8-E03
DATASETS=eodata,covertype,crop_mapping,diabetes130,higgs,har,adult,gas_drift,heloc,phishing,eye_movements,spambase,ozone_8hr,pc4,mice_protein,qsar_biodeg
METHODS=fastener:llm_llama70b_proposer,fastener:llm_gemma4b_proposer,fastener:llm_gemma27b_proposer,fastener:llm_ministral8b_proposer,fastener:llm_qwen14b_proposer,fastener:llm_phi4_proposer,fastener:llm_deepseekflash_proposer,fastener:llm_gptluna_proposer,fastener:llm_geminilite_proposer,fastener:none,fastener:seed_mrmr,fastener:llm_llama70b,fastener:llm_gemma4b,fastener:llm_gemma27b,fastener:llm_ministral8b,fastener:llm_qwen14b,fastener:llm_phi4,fastener:llm_deepseekflash,fastener:llm_gptluna,fastener:llm_geminilite,fastener:llm_llama70b_scrambled,fastener:llm_gemma4b_scrambled,fastener:llm_gemma27b_scrambled,fastener:llm_ministral8b_scrambled,fastener:llm_qwen14b_scrambled,fastener:llm_phi4_scrambled,fastener:llm_deepseekflash_scrambled,fastener:llm_gptluna_scrambled,fastener:llm_geminilite_scrambled,fastener:llm_llama70b_blind,fastener:llm_gemma4b_blind,fastener:llm_gemma27b_blind,fastener:llm_ministral8b_blind,fastener:llm_qwen14b_blind,fastener:llm_phi4_blind,fastener:llm_deepseekflash_blind,fastener:llm_gptluna_blind,fastener:llm_geminilite_blind,fastener:llm_llama70b_mating,fastener:llm_llama70b_mutation,fastener:llm_llama70b_initial
BUDGETS=experiments/h8_budgets.json
SKIP=hpc/vega/h8e01_skip.txt
TIMEOUT_HOURS=6
RUN_ARGS="--model lgbm"
# test.sbatch's step 2: a quick real job
TEST_CELL=qsar_biodeg:fastener_none
