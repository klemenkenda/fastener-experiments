# H8-E03 as revised on 2026-10-31 (DEC-53), before any run: for each of the
# twelve models the prior alone (lambda 1) and the same prior permuted across
# the columns; mutual-information guidance alone (flat prior) and stock
# FASTENER once; for the nine new models also H8-E01's prior arm (lambda 0.5).
# Every prior is a committed file: no model call during the runs.
EXPERIMENT=H8-E03
DATASETS=eodata,covertype,crop_mapping,diabetes130,higgs,har,adult,gas_drift,heloc,phishing,eye_movements,spambase,ozone_8hr,pc4,mice_protein,qsar_biodeg
METHODS=fastener:mi_only,fastener:none,fastener:llm_opus_l1,fastener:llm_sonnet_l1,fastener:llm_haiku_l1,fastener:llm_llama70b_l1,fastener:llm_gemma4b_l1,fastener:llm_gemma27b_l1,fastener:llm_ministral8b_l1,fastener:llm_qwen14b_l1,fastener:llm_phi4_l1,fastener:llm_deepseekflash_l1,fastener:llm_gptluna_l1,fastener:llm_geminilite_l1,fastener:llm_opus_permuted_l1,fastener:llm_sonnet_permuted_l1,fastener:llm_haiku_permuted_l1,fastener:llm_llama70b_permuted_l1,fastener:llm_gemma4b_permuted_l1,fastener:llm_gemma27b_permuted_l1,fastener:llm_ministral8b_permuted_l1,fastener:llm_qwen14b_permuted_l1,fastener:llm_phi4_permuted_l1,fastener:llm_deepseekflash_permuted_l1,fastener:llm_gptluna_permuted_l1,fastener:llm_geminilite_permuted_l1,fastener:llm_llama70b,fastener:llm_gemma4b,fastener:llm_gemma27b,fastener:llm_ministral8b,fastener:llm_qwen14b,fastener:llm_phi4,fastener:llm_deepseekflash,fastener:llm_gptluna,fastener:llm_geminilite
BUDGETS=experiments/h8_budgets.json
SKIP=hpc/vega/h8e01_skip.txt
TIMEOUT_HOURS=6
RUN_ARGS="--model lgbm"
# test.sbatch's step 2: a quick real job (a permuted prior: reads a committed file)
TEST_CELL=qsar_biodeg:fastener_llm_gemma4b_permuted_l1
