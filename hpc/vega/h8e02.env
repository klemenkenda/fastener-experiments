# H8-E02: the strict (blind) control for H8-E01 (DEC-51): three arms whose
# prior was made with the features shuffled, named by position, and no
# dataset description. H8-E01's setup otherwise; no model calls during runs.
EXPERIMENT=H8-E02
DATASETS=eodata,covertype,crop_mapping,diabetes130,higgs,har,adult,gas_drift,heloc,phishing,eye_movements,spambase,ozone_8hr,pc4,mice_protein,qsar_biodeg
METHODS=fastener:llm_opus_blind,fastener:llm_sonnet_blind,fastener:llm_haiku_blind
BUDGETS=experiments/h8_budgets.json
SKIP=hpc/vega/h8e01_skip.txt
TIMEOUT_HOURS=6
RUN_ARGS="--model lgbm"
# test.sbatch's step 2: a quick real job
TEST_CELL=qsar_biodeg:fastener_llm_haiku_blind
