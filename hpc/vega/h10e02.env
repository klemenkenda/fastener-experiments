# H10-E02: H10-E01's two seeded arms under the random forest, on H5H6-E02's
# grid and setup: the same datasets, fit budgets, 6-hour cap and 8 cores.
# Compared with H5H6-E02's own fastener and mrmr runs (DEC-46).
EXPERIMENT=H10-E02
DATASETS=eodata,SelfRegulationSCP1,UWaveGestureLibraryAll,PEMS-SF,HandOutlines,ElectricDevices,Heartbeat,FordA,StarLightCurves,EthanolConcentration,Crop,EigenWorms,CinCECGTorso,FaceDetection,FaultDetectionA,MotorImagery,LSST,ECG5000,ChlorineConcentration,PhonemeSpectra,Wafer,Adiac,Computers,NATOPS,FingerMovements,MedicalImages,Earthquakes,ProximalPhalanxOutlineCorrect,Libras,Strawberry,Epilepsy,PenDigits,BeetleFly,TwoLeadECG,OliveOil,Coffee,ItalyPowerDemand,Ham,BasicMotions
METHODS=fastener:seed_mrmr,fastener:seed_boruta
BUDGETS=experiments/h2h3_budgets.json
SKIP=hpc/vega/h10e02_skip.txt
TIMEOUT_HOURS=6
RUN_ARGS="--model rf"
# test.sbatch's step 2: the cheapest real job (no all_features arm here;
# under the forest Coffee takes 30-35 min, over the test job's 30-min limit)
TEST_CELL=BasicMotions:fastener_seed_mrmr
