# The upstream FASTENER clone lives here as an independent git repo.
# It is deliberately NOT tracked by this experiments repo.
fastener/

# Experiment outputs stay on the machine that ran them: there are too many
# files to track. The reports under reports/ keep what the analysis read.
results/*
!results/.gitkeep

# Inputs are fetched and checksum-verified by download_data.py, not stored here.
data/*
!data/.gitkeep

# Pickled FASTENER states
*.pkl

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Environments
.venv/
venv/
env/
# HPC Vega: the Python environment setup.sh builds, and local settings.
.hpc/
hpc/vega/config.local.sh

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# The ledger's lock, held while a run is recorded (experiment_ids.ledger_lock).
experiments/EXPERIMENTS.md.lock
