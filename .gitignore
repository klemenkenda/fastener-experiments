# The upstream FASTENER clone lives here as an independent git repo.
# It is deliberately NOT tracked by this experiments repo.
fastener/

# Experiment outputs. The small, human-meaningful summaries of each run ARE
# tracked -- they are the record of what was run and what came out. FASTENER's
# per-generation pickles are not: thousands of files per run, reproducible from
# the manifest's seeds and commit.
results/**/log/
results/**/*.pickle

# Inputs are fetched and checksum-verified by download_data.py, not stored here.
data/*
!data/.gitkeep

# Pickled FASTENER states
*.pkl

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Environments
.venv/
venv/
env/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Live progress heartbeats and background run logs: per-run scratch, not results.
results/**/progress.json
results/*.log
